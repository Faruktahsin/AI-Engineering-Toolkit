# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly set text files to LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Denote binary files
*.db binary
*.png binary
*.jpg binary
