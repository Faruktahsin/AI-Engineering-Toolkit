{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pakb.org/schemas/v1/pakb-schema.json",
  "title": "Personal AI Knowledge Base (PAKB) Schema Specification v1.0",
  "description": "Canonical JSON Schema Draft 2020-12 for the 5 PAKB Fundamental Primitives (Entity, Directive, Assertion, Event, Relation) fully conformant with PAKB Architecture Decision Records v1.0.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/Entity" },
    { "$ref": "#/$defs/Directive" },
    { "$ref": "#/$defs/Assertion" },
    { "$ref": "#/$defs/Event" },
    { "$ref": "#/$defs/Relation" }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\\\.[0-9]+\\.[0-9]+$",
      "description": "SemVer schema version string."
    },
    "iso_utc_timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "ADR-001 Section 3.1 Strict ISO 8601 UTC timestamp format."
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ent_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID for Entity primitives."
    },
    "directive_id": {
      "type": "string",
      "pattern": "^dir_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID for Directive primitives."
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^ast_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID for Assertion primitives."
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID for Event primitives."
    },
    "relation_id": {
      "type": "string",
      "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID for Relation primitives."
    },
    "any_primitive_id": {
      "type": "string",
      "pattern": "^(ent|dir|ast|evt|rel)_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ADR-001 Prefixed Base32 ULID matching any valid primitive class."
    },
    "sensitivity_enum": {
      "type": "string",
      "enum": ["public", "internal", "restricted"],
      "description": "ADR-002 Universal privacy classification tier."
    },
    "volatility_enum": {
      "type": "string",
      "enum": ["invariant", "low", "medium", "high"],
      "description": "Expected rate of state change over time."
    },
    "activation_enum": {
      "type": "string",
      "enum": ["always_on", "on_demand", "restricted"],
      "description": "ADR-004 Context routing activation class."
    },
    "evidence_type_enum": {
      "type": "string",
      "enum": ["observed", "stated", "inferred"],
      "description": "Provenance evidence classification."
    },
    "enforcement_enum": {
      "type": "string",
      "enum": ["hard", "soft"],
      "description": "Directive severity: hard (Constraint) vs soft (Preference)."
    },
    "entity_type_enum": {
      "type": "string",
      "enum": ["owner", "contact", "organization", "workstream", "objective", "environment"],
      "description": "Discriminant category for Entity primitives."
    },
    "entity_status_enum": {
      "type": "string",
      "enum": ["idea", "active", "paused", "completed", "archived"],
      "description": "Operational state for Entity primitives."
    },
    "assertion_type_enum": {
      "type": "string",
      "enum": ["fact", "decision_adr", "insight", "credential_reference"],
      "description": "Discriminant type for Assertion primitives."
    },
    "assertion_status_enum": {
      "type": "string",
      "enum": ["proposed", "accepted", "superseded"],
      "description": "State for decision ADR assertions."
    },
    "event_type_enum": {
      "type": "string",
      "enum": ["milestone", "session_log", "interaction", "state_change"],
      "description": "Classification for Event primitives."
    },
    "cadence_enum": {
      "type": "string",
      "enum": ["daily", "weekly", "monthly", "on_event"],
      "description": "Recurrence pattern for Directive routines."
    },
    "predicate_type": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "governs",
            "owns",
            "depends_on",
            "supersedes",
            "supports",
            "located_at",
            "member_of"
          ]
        },
        {
          "pattern": "^ext_[a-z0-9_]+$"
        }
      ],
      "description": "ADR-003 Core predicate enum or ext_ prefixed extension predicate."
    },
    "ephemeral_metadata": {
      "type": "object",
      "description": "ADR-005 Restricted key-value store for ephemeral UI/tool state only.",
      "propertyNames": {
        "pattern": "^(?!ent_|dir_|ast_|evt_|rel_|scoped_entity_id|target_id|source_id).*$"
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "Entity": {
      "type": "object",
      "description": "ENTITY primitive representing subjects, actors, workstreams, objectives, and environments.",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/entity_id" },
        "created_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "updated_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "last_verified": { "$ref": "#/$defs/iso_utc_timestamp" },
        "sensitivity": { "$ref": "#/$defs/sensitivity_enum" },
        "volatility": { "$ref": "#/$defs/volatility_enum" },
        "activation": { "$ref": "#/$defs/activation_enum" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "$ref": "#/$defs/entity_type_enum" },
        "status": { "$ref": "#/$defs/entity_status_enum" },
        "locale_info": {
          "type": "object",
          "properties": {
            "timezone": { "type": "string" },
            "language": { "type": "string" },
            "location": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string", "maxLength": 4096 },
        "metadata": { "$ref": "#/$defs/ephemeral_metadata" }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "updated_at",
        "last_verified",
        "sensitivity",
        "volatility",
        "activation",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Directive": {
      "type": "object",
      "description": "DIRECTIVE primitive representing rules, guardrails, preferences, and operational routines.",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/directive_id" },
        "created_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "updated_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "last_verified": { "$ref": "#/$defs/iso_utc_timestamp" },
        "sensitivity": { "$ref": "#/$defs/sensitivity_enum" },
        "volatility": { "$ref": "#/$defs/volatility_enum" },
        "activation": { "$ref": "#/$defs/activation_enum" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "enforcement": { "$ref": "#/$defs/enforcement_enum" },
        "domain": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cadence": { "$ref": "#/$defs/cadence_enum" },
        "exemption_scope": { "type": "string", "maxLength": 1024 },
        "rationale": { "type": "string", "maxLength": 2048 },
        "metadata": { "$ref": "#/$defs/ephemeral_metadata" }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "updated_at",
        "last_verified",
        "sensitivity",
        "volatility",
        "activation",
        "statement",
        "enforcement",
        "domain"
      ],
      "additionalProperties": false
    },
    "Assertion": {
      "type": "object",
      "description": "ASSERTION primitive representing claims of truth, domain models, decisions, and credential references.",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/assertion_id" },
        "created_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "updated_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "last_verified": { "$ref": "#/$defs/iso_utc_timestamp" },
        "sensitivity": { "$ref": "#/$defs/sensitivity_enum" },
        "volatility": { "$ref": "#/$defs/volatility_enum" },
        "activation": { "$ref": "#/$defs/activation_enum" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence_type": { "$ref": "#/$defs/evidence_type_enum" },
        "type": { "$ref": "#/$defs/assertion_type_enum" },
        "status": { "$ref": "#/$defs/assertion_status_enum" },
        "source": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
        "valid_from": { "$ref": "#/$defs/iso_utc_timestamp" },
        "valid_to": { "$ref": "#/$defs/iso_utc_timestamp" },
        "metadata": { "$ref": "#/$defs/ephemeral_metadata" }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "updated_at",
        "last_verified",
        "sensitivity",
        "volatility",
        "activation",
        "claim",
        "evidence_type",
        "type"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "description": "EVENT primitive representing temporal occurrences, session logs, and milestones.",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/event_id" },
        "created_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "updated_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "last_verified": { "$ref": "#/$defs/iso_utc_timestamp" },
        "sensitivity": { "$ref": "#/$defs/sensitivity_enum" },
        "volatility": { "$ref": "#/$defs/volatility_enum" },
        "activation": { "$ref": "#/$defs/activation_enum" },
        "timestamp": { "$ref": "#/$defs/iso_utc_timestamp" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "type": { "$ref": "#/$defs/event_type_enum" },
        "impact_summary": { "type": "string", "maxLength": 2048 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "uniqueItems": true
        },
        "metadata": { "$ref": "#/$defs/ephemeral_metadata" }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "updated_at",
        "last_verified",
        "sensitivity",
        "volatility",
        "activation",
        "timestamp",
        "summary"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "description": "RELATION primitive representing typed, directed semantic edges between nodes.",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/relation_id" },
        "created_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "updated_at": { "$ref": "#/$defs/iso_utc_timestamp" },
        "last_verified": { "$ref": "#/$defs/iso_utc_timestamp" },
        "sensitivity": { "$ref": "#/$defs/sensitivity_enum" },
        "volatility": { "$ref": "#/$defs/volatility_enum" },
        "activation": { "$ref": "#/$defs/activation_enum" },
        "source_id": { "$ref": "#/$defs/any_primitive_id" },
        "target_id": { "$ref": "#/$defs/any_primitive_id" },
        "predicate": { "$ref": "#/$defs/predicate_type" },
        "valid_from": { "$ref": "#/$defs/iso_utc_timestamp" },
        "valid_to": { "$ref": "#/$defs/iso_utc_timestamp" },
        "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "metadata": { "$ref": "#/$defs/ephemeral_metadata" }
      },
      "required": [
        "schema_version",
        "id",
        "created_at",
        "updated_at",
        "last_verified",
        "sensitivity",
        "volatility",
        "activation",
        "source_id",
        "target_id",
        "predicate"
      ],
      "additionalProperties": false
    }
  }
}
