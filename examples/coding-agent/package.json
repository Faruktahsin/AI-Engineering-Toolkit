{
  "name": "@aiet/example-coding-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI Coding Assistant with persistent developer memory built on AIET infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs && tsc --emitDeclarationOnly",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiet/core": "workspace:*",
    "@aiet/domain": "workspace:*",
    "@aiet/mcp-server": "workspace:*",
    "@aiet/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
