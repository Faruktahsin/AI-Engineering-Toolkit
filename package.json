{
  "name": "aiet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Engineering Toolkit & PAKB Monorepo",
  "author": "Faruk Tahsin <faruktahsin@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "benchmark": "pnpm --filter @aiet/testing benchmark",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean",
    "check:node": "node scripts/verify-node.mjs",
    "check:zero-width": "node scripts/check-zero-width.mjs",
    "check:secrets": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "^2.27.7",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "pnpm": "11.20.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
