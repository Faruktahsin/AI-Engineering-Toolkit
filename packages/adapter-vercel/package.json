{
  "name": "@aiet/adapter-vercel",
  "version": "1.0.0",
  "description": "Vercel AI SDK adapter for AI-Engineering-Toolkit (AIET) context compilation and local memory",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/compiler": "workspace:*",
    "@aiet/core": "workspace:*",
    "@aiet/schema": "workspace:*",
    "@aiet/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
