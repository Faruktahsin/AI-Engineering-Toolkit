{
  "name": "@aiet/cli",
  "version": "1.0.0",
  "description": "Production CLI for compiling Personal AI Knowledge Base (PAKB) context artifacts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "pakb": "./dist/bin.js",
    "pakb-compile": "./dist/bin.js",
    "aiet": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/compiler": "workspace:*",
    "@aiet/domain": "workspace:*",
    "@aiet/schema": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
