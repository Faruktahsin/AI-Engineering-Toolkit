{
  "name": "@aiet/cli",
  "version": "1.0.2",
  "description": "Developer CLI for AI Engineering Toolkit (AIET) context and memory workflows",
  "author": "Faruk Tahsin <faruktahsin@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Faruktahsin/AI-Engineering-Toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faruktahsin/AI-Engineering-Toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Faruktahsin/AI-Engineering-Toolkit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "pakb": "./dist/bin.js",
    "pakb-compile": "./dist/bin.js",
    "aiet": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/compiler": "workspace:*",
    "@aiet/decision-engine": "workspace:*",
    "@aiet/domain": "workspace:*",
    "@aiet/embeddings": "workspace:*",
    "@aiet/extractor": "workspace:*",
    "@aiet/governance": "workspace:*",
    "@aiet/schema": "workspace:*",
    "@aiet/storage": "workspace:*",
    "@types/chokidar": "^2.1.7",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Faruktahsin"
  }
}
