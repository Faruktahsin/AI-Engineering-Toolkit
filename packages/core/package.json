{
  "name": "@aiet/core",
  "version": "1.0.0",
  "description": "Primary public TypeScript SDK for AI Engineering Toolkit (AIET), providing stable re-exports of core schema, domain, storage, MCP, and compiler APIs.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/compiler": "workspace:*",
    "@aiet/domain": "workspace:*",
    "@aiet/mcp-server": "workspace:*",
    "@aiet/schema": "workspace:*",
    "@aiet/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
