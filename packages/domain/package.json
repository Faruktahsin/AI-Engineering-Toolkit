{
  "name": "@aiet/domain",
  "version": "1.0.2",
  "description": "Canonical Prefixed Base32 ULID generator, text sanitizer, and schema validation engine for PAKB",
  "author": "Faruk Tahsin <faruktahsin@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Faruktahsin/AI-Engineering-Toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faruktahsin/AI-Engineering-Toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Faruktahsin/AI-Engineering-Toolkit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/schema": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Faruktahsin"
  }
}
