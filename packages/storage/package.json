{
  "name": "@aiet/storage",
  "version": "1.0.2",
  "description": "Canonical SQLite storage engine, DDL migrations, Drizzle ORM, JCS hash, and graph query engine for PAKB",
  "author": "Faruk Tahsin <faruktahsin@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Faruktahsin/AI-Engineering-Toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faruktahsin/AI-Engineering-Toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Faruktahsin/AI-Engineering-Toolkit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/domain": "workspace:*",
    "@aiet/embeddings": "workspace:*",
    "@aiet/schema": "workspace:*",
    "better-sqlite3": "^11.1.2",
    "canonicalize": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Faruktahsin"
  }
}
