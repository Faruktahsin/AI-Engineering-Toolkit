{
  "name": "@aiet/storage",
  "version": "1.0.0",
  "description": "Canonical SQLite storage engine, DDL migrations, Drizzle ORM, JCS hash, and graph query engine for PAKB",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aiet/domain": "workspace:*",
    "@aiet/embeddings": "workspace:*",
    "@aiet/schema": "workspace:*",
    "better-sqlite3": "^11.1.2",
    "canonicalize": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
