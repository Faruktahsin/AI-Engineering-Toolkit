{
  "name": "@aiet/utils",
  "version": "1.0.1",
  "description": "Pure reusable utilities for hashing, filesystem, paths, JSON, UTF-8, retries, async, and collections for AIET",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Faruktahsin"
  }
}
